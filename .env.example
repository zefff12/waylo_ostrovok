# Скопируйте в .env и заполните. Все ключи необязательны: без них работает офлайн-агент и демо-данные.

# Какую нейросеть использовать: auto | gigachat | claude | offline
# auto — первая, для которой задан ключ (Claude, затем GigaChat); offline — агент на правилах без LLM
WAYLO_LLM=auto

# GigaChat (Сбер) — бесплатный пакет токенов для физлиц: https://developers.sber.ru/studio
# Ключ авторизации из личного кабинета (это Base64 от Client ID:Client Secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Сертификат API выдан Russian Trusted Root CA (Минцифры). Скачайте корневой сертификат
# с https://www.gosuslugi.ru/crt (файл .crt/.pem) и укажите путь:
GIGACHAT_CA_BUNDLE=
# Только для локальной проверки, если сертификата нет: отключить проверку TLS (небезопасно)
# GIGACHAT_VERIFY_SSL=false

# Claude (Anthropic API) — включает агента на Claude с tool calling (по умолчанию Haiku 5.5)
ANTHROPIC_API_KEY=
# Модель: claude-haiku-5-5 (дёшево, по умолчанию) или claude-opus-5-5 (умнее, ~40× дороже на входе)
# Глубина рассуждений: low | medium | high | xhigh | max
WAYLO_MODEL=claude-haiku-5-5
WAYLO_EFFORT=medium

# Travelpayouts / Aviasales Data API — реальные цены перелётов из кэша поисков
# Токен: https://www.travelpayouts.com/ → Профиль → API-токен
TRAVELPAYOUTS_TOKEN=

# 2ГИС Places API — кафе и места рядом (иначе OpenStreetMap Overpass)
# Демо-ключ: https://dev.2gis.ru/
DGIS_API_KEY=

# Яндекс Карты: https://yandex.ru/maps-api/console — продукты «JavaScript API» и «API Геокодера»
# (бесплатные тарифы: 100 загрузок карты и 1000 запросов геокодера в сутки), оба привязаны к одному ключу.
# В настройках ключа укажите HTTP Referer localhost. Без ключа карта — OpenStreetMap.
# Ключ MapKit SDK (мобильные приложения) для сайта не подходит.
YANDEX_JS_API_KEY=

# Фоновое видео главного экрана: ссылка на YouTube (встраивается официальным плеером без звука;
# если YouTube недоступен, показывается локальное видео из frontend/public/media)
WAYLO_HOME_VIDEO=https://youtu.be/lyh2kAjcmSY

# Путь к SQLite (по умолчанию backend/waylo.sqlite3)
# WAYLO_DB=
